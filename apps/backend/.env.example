# Backend environment variables (copy to .env and fill in real values)

# Server
PORT=3002
CORS_ORIGIN=http://localhost:3000

# S3-compatible media storage (dev: Supabase Storage — launch: Cloudflare R2)
# The backend talks plain S3; switching providers at launch is an env change only.
#
# Supabase Storage setup (free tier, no credit card required):
#   1. Sign up at supabase.com (e.g. with GitHub) -> New Project
#   2. Storage -> New bucket -> name it (e.g. croshfinal-dev) -> toggle "Public bucket" ON
#   3. Project Settings -> Storage -> create S3 access key pair; note the region shown there
#   4. Fill in the values below:
#        S3_ENDPOINT       https://<project-ref>.supabase.co/storage/v1/s3
#        S3_REGION         region from the S3 credentials page (e.g. us-east-1)
#        S3_BUCKET         croshfinal-dev
#        S3_PUBLIC_BASE_URL https://<project-ref>.supabase.co/storage/v1/object/public/croshfinal-dev
#
# Cloudflare R2 cutover at launch:
#   Set S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com, S3_REGION=auto,
#   plus the R2 access key / secret / bucket / public base URL. No code changes.
S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-storage-access-key-id
S3_SECRET_ACCESS_KEY=your-storage-secret-access-key
S3_BUCKET=croshfinal-dev
S3_PUBLIC_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/croshfinal-dev
